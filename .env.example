# Copie para .env.local e preencha com os dados do seu projeto no Supabase
# (Project Settings > API). A chave "anon" é pública por natureza; nunca use a "service_role" aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon
# Endereço publicado do app (para os links de e-mail voltarem ao lugar certo)
VITE_APP_URL=https://gabrielbaumgratz.github.io/Baumfinances/
